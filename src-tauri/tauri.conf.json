{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DBY Label Pricing",
  "version": "0.1.14",
  "identifier": "vn.unitech.pricing",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DBY Label Pricing",
        "width": 1360,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 760,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MkQwOEJGRjk5MkY3MTkKUldRWjk1TDV2d2d0UklxZVppWUJkaTdib2xRaXA0NDJrRHdFdWF3cDV6TTIzUGpnWDBveEtDTDEK",
      "endpoints": [
        "https://github.com/yendao444-del/unitech-pricing/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
